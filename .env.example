# Contact Information Environment Variables
# Copy this file to .env.local and update with your actual values

# Phone number (without + prefix, just numbers)
# Example: 905432341401
NEXT_PUBLIC_PHONE_NUMBER=

# Phone number display format (how it appears to users)
# Example: 0543 234 1401
NEXT_PUBLIC_PHONE_DISPLAY=

# Email address
# Example: info@akdenizyapimarket.com
NEXT_PUBLIC_EMAIL=

# Business address - Line 1
# Example: Altınkum, Gazi Mustafa Kemal Blv.
NEXT_PUBLIC_ADDRESS_LINE1=

# Business address - Line 2
# Example: Konyaaltı / Antalya
NEXT_PUBLIC_ADDRESS_LINE2=

# Full address for map links
# Example: Altınkum, Gazi Mustafa Kemal Blv., Konyaaltı, Antalya
NEXT_PUBLIC_ADDRESS_FULL=

# Business hours - Weekdays
# Example: Pazartesi - Cumartesi: 08:00 - 20:00
NEXT_PUBLIC_HOURS_WEEKDAY=

# Business hours - Weekend
# Example: Pazar: 09:00 - 18:00
NEXT_PUBLIC_HOURS_WEEKEND=

# Emergency hours
# Example: Acil Servis: 24/7
NEXT_PUBLIC_HOURS_EMERGENCY=

# Social media URLs (optional, leave empty if not used)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Business name
# Example: Akdeniz Yapı Market
NEXT_PUBLIC_BUSINESS_NAME=

# Business tagline
# Example: Konyaaltı Anahtar & Çilingir
NEXT_PUBLIC_BUSINESS_TAGLINE=

# Map embed URL (Get this from Google Maps embed code)
# Example: https://www.google.com/maps/embed?pb=!1m18!1m12!...
NEXT_PUBLIC_MAP_EMBED_URL=
